# CoDeva Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Provide local MongoDB or Atlas URI. If omitted or unreachable in development,
# CoDeva automatically starts a local development in-memory MongoDB instance.
MONGODB_URI=mongodb://127.0.0.1:27017/codeva

# Security
JWT_SECRET=codeva_super_secret_jwt_key_at_least_32_characters_long_btech_cs_demo
JWT_EXPIRES_IN=7d

# OpenAI AI Coding Assistant
# Obtain key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Judge0 Code Execution
# Public Judge0 CE endpoint or RapidAPI Judge0 endpoint
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_AUTH_HEADER=X-Auth-Token
